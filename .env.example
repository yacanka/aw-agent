# Copy to .env using CMD: if not exist .env copy .env.example .env
# Values are literal. No variable expansion or inline comments.
GEMMA_MODEL_PATH=model/model.gguf
GEMMA_N_GPU_LAYERS=-1
GEMMA_N_CTX=16384
GEMMA_MAX_TOKENS=2048
GEMMA_SHOW_THOUGHTS=0
JIRA_BASE_URL=https://jira.example.com
JIRA_JSESSIONID=
# Optional corporate CA bundle. TLS verification is always enabled.
JIRA_CA_FILE=
